<mujoco model="grasp_target_box">
  <worldbody>
    <body name="grasp_target" pos="0.5 0.0 0.03">
      <freejoint name="grasp_target_joint"/>
      <!-- Box (0.04 x 0.04 x 0.06 m) replaces the cylinder: flat faces give stable
           table contact (< 4 mm settling vs 18 mm for cylinder) and bilateral
           gripper contact at the equator without wedge-induced downward slip. -->
      <geom name="grasp_target_geom" type="box" size="0.02 0.02 0.03"
            rgba="0.9 0.4 0.1 1" mass="0.05" contype="1" conaffinity="1"
            friction="3.5 0.1 0.01"/>
    </body>
    <!-- Multi-angle cameras (identical to grasp_target.xml) -->
    <camera name="overview" pos="0.0 -1.2 1.4" euler="55 0 0"/>
    <camera name="side" pos="-1.4 0.0 0.8" euler="0 -75 0"/>
    <camera name="top_down" pos="0.0 0.0 2.2" euler="90 0 0"/>
    <camera name="wrist" mode="fixed" pos="0.5 0.0 0.4" euler="90 0 180"/>
  </worldbody>
</mujoco>
