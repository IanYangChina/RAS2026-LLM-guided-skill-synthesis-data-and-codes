<mujoco model="obstacle_block">
  <worldbody>
    <body name="obstacle_block" pos="0.5 0.0 0.15">
      <geom name="obstacle_block_geom" type="box" size="0.04 0.15 0.15"
            rgba="0.9 0.4 0.1 1" contype="1" conaffinity="1"/>
    </body>
    <!-- Multi-angle cameras for obstacle_reach diagnostics -->
    <camera name="overview" pos="0.0 -1.2 1.4" euler="55 0 0"/>
    <camera name="side" pos="-1.4 0.0 0.8" euler="0 -75 0"/>
    <camera name="top_down" pos="0.0 0.0 2.2" euler="90 0 0"/>
    <!-- Wrist camera approximates TCP view (static until MJCF body-attachment upgrade). -->
    <camera name="wrist" mode="fixed" pos="0.5 0.0 0.35" euler="90 0 180"/>
  </worldbody>
</mujoco>
